# ==============================================================================
# PingMe Production Environment Variables Configuration Template
# ==============================================================================
# Copy this file to `.env` or `.env.local` and replace placeholders with actual values.
# NEVER commit your populated `.env` files to version control.
# ==============================================================================

# 1. DATABASE
# MongoDB Atlas connection string (must be MongoDB 4.2+ supporting transactions/replica sets)
DATABASE_URL="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/pingme?retryWrites=true&w=majority"

# 2. AUTHENTICATION (NextAuth v5 / Auth.js)
# Random 32+ character secret string used to sign JWT sessions (generate via `openssl rand -base64 32`)
NEXTAUTH_SECRET="your-32-character-random-secret-key-here"
# Canonical URL of your deployment (e.g. http://localhost:3000 locally or https://yourdomain.vercel.app in production)
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth Credentials (obtain from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# 3. END-TO-END & SERVER-SIDE ENCRYPTION
# 64-character hexadecimal master key used for AES-256-CBC message encryption at rest
# Generate via Node console: `require('crypto').randomBytes(32).toString('hex')`
ENCRYPTION_MASTER_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# 4. REAL-TIME SOCKET.IO SERVER
# URL for client-side socket connection
NEXT_PUBLIC_SOCKET_URL="http://localhost:3000"
SOCKET_SERVER_URL="http://localhost:3000"

# 5. FILE UPLOAD PROVIDER (Cloudinary / UploadThing / AWS S3)
# Required if enabling rich multimedia and voice sharing
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# 6. WEBRTC VOICE & VIDEO CALLING (TURN / STUN Servers)
# Required for traversing NAT/Firewalls during peer-to-peer WebRTC calls (e.g., Twilio or Metered TURN)
TURN_SERVER_URL="turn:turn.yourprovider.com:3478"
TURN_SERVER_USERNAME="your-turn-username"
TURN_SERVER_PASSWORD="your-turn-password"

# 7. EMAIL SERVICE (SMTP / Resend)
# Optional: Used for verification emails and system notifications
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="apikey"
SMTP_PASSWORD="your-smtp-password"

# 8. OPTIONAL ANALYTICS & MONITORING
ANALYTICS_PROVIDER_KEY="your-analytics-key"
SENTRY_DSN="https://xxxx@sentry.io/xxxx"
